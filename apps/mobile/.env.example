# Copy to .env. The API's base URL including the version.
# iOS only allows plain HTTP to local hosts (localhost, IPs), so serve the API with
# `php artisan serve` in apps/api rather than using Herd's lockmate-api.test.
# Android emulator: http://10.0.2.2:8000/api/v1. A real phone: your Mac's LAN IP, with
# `php artisan serve --host 0.0.0.0`.
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
